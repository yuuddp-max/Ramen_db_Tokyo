# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud: browser key is restricted to your deployed domains;
# server key is restricted to Places API (New). Never expose it to the client.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-maps-key
GOOGLE_PLACES_API_KEY=your-server-places-api-key

# Protects the data-import endpoint. Set a long random string in Vercel.
IMPORT_API_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# Google DriveのCSVをVercelから読む場合は、ファイルを「リンクを知っている全員・閲覧可」にして、URLまたはIDを設定します。
GOOGLE_DRIVE_NEWS_CSV_URL=
GOOGLE_DRIVE_NEWS_FILE_ID=

# AI soup research agent. Both values are server-only; never use NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
RESEARCH_API_SECRET=replace-with-a-second-long-random-secret
# Password protecting /admin/research. Use a separate long random string.
RESEARCH_ADMIN_PASSWORD=replace-with-a-third-long-random-secret
# Required by Vercel Cron. Use a separate long random string.
CRON_SECRET=replace-with-a-fourth-long-random-secret
# Optional: low-cost model used for official-site classification and one-search fallback.
OPENAI_LOW_COST_RESEARCH_MODEL=gpt-5.4-nano
