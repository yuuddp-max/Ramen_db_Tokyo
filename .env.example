# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud: browser key is restricted to your deployed domains;
# server key is restricted to Places API (New). Never expose it to the client.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-maps-key
GOOGLE_PLACES_API_KEY=your-server-places-api-key

# Protects the data-import endpoint. Set a long random string in Vercel.
IMPORT_API_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
